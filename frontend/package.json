    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "tailwindcss": "4.1.13",
    "typescript": "5.7.2"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.13": true,
    "sharp@0.35.5": true
