# Copy to .env. Generate secrets with: openssl rand -hex 32
# Staff bearer token (32+ characters, shorter ones are refused): unlocks GET /api/leads,
# PATCH /api/alerts and the /login page.
ADMIN_TOKEN=
# Shared secret the frontend proxy sends as X-Proxy-Key; the API refuses requests without it.
PROXY_SECRET=
# 1 enables Swagger at /api/docs on the API (never on in production)
DEBUG=0
# backend
DATABASE_URL=sqlite:///./data/enprove.db
# 1 only behind a reverse proxy that sets X-Real-IP / appends X-Forwarded-For; enables per-visitor limits
TRUST_PROXY=0
# frontend (server-side only)
API_URL=http://localhost:8100
